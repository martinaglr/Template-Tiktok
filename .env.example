# --- Site ---------------------------------------------------------------
# NEXT_PUBLIC_* are baked in at BUILD time. Set before `npm run deploy`;
# `wrangler secret put` will NOT reach them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Ad tech (browser) ----------------------------------------------------
# Leave empty to keep pixels dormant — safe to ship without them.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Ad tech (server, Conversions API) — secrets, Phase 6 -----------------
META_CAPI_ACCESS_TOKEN=
TIKTOK_EVENTS_ACCESS_TOKEN=

# --- Flow (flow.cl) — secrets, Phase 2 -------------------------------------
# MockPaymentProvider is used locally until both keys are set.
FLOW_API_KEY=
FLOW_SECRET_KEY=
# https://sandbox.flow.cl/api (pruebas) | https://www.flow.cl/api (prod)
FLOW_API_BASE=https://sandbox.flow.cl/api

# --- Email (Resend) — secrets, Phase 4 -------------------------------------
# ConsoleEmailProvider (logs only) is used locally until RESEND_API_KEY is set.
RESEND_API_KEY=
EMAIL_FROM="Nombre Tienda <pedidos@dominio-del-cliente.cl>"
EMAIL_MERCHANT_NOTIFY=ana@dominio-del-cliente.cl
